{
  "name": "DropBazaar - Unofficial Item Shop Viewer",
  "short_name": "DropBazaar",
  "description": "Unofficial fan app that shows the current Fortnite Item Shop.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
